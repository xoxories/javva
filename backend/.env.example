LLM_PROVIDER=gemini
GEMINI_API_KEY=AIza...
GEMINI_DEFAULT_MODEL=gemini-2.5-flash-lite

# Vertex AI (recommended for production)
# Set USE_VERTEX_AI=true to leverage GCP credits and higher quotas via
# Application Default Credentials (run `gcloud auth application-default
# login` first). When false, falls back to aistudio.google.com Gemini API
# direct via GEMINI_API_KEY (20 RPD free tier cap on gemini-2.5-* models).
USE_VERTEX_AI=false
GCP_PROJECT_ID=your-project-id
GCP_LOCATION=us-central1

# === Service Account credentials (Vertex AI auth) ===
# Use ONE of the following. The startup decoder
# (app/credentials.py) prefers Option A; falls back to Option B.
#
# Option A (local dev): Path to JSON key file.
# GOOGLE_APPLICATION_CREDENTIALS=./service-account-key.json
#
# Option B (production: Railway, Render, etc.): Base64-encoded JSON.
# Encode locally with:  base64 -w 0 service-account-key.json
# At startup, the decoder writes /tmp/sa-key.json (0600) and exports
# GOOGLE_APPLICATION_CREDENTIALS for the SDK.
# GOOGLE_APPLICATION_CREDENTIALS_JSON=<base64-string>

DATABASE_URL=
QDRANT_URL=
QDRANT_API_KEY=

# Langfuse Observability (optional, recommended for production)
# Free tier: 50K observations/month at cloud.langfuse.com.
# Set LANGFUSE_ENABLED=false to skip tracing entirely (e.g. in CI).
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key-here
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key-here
LANGFUSE_ENABLED=true

JWT_SECRET=
CORS_ORIGINS=
ENV=development
LOG_LEVEL=INFO

# API auth (X-API-Key header for /chat endpoints).
# Leave unset for dev — auth is disabled and a warning is logged at startup.
# Generate a random secret for staging/prod (e.g. `openssl rand -hex 16`).
API_KEY=
